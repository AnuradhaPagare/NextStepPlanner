# NextStep Planner Frontend - Environment Variables for Vercel
# Copy this to .env.local and update the backend URL after backend deployment

# Backend API URL (Update this after deploying the backend)
VITE_API_URL=https://your-backend-app.vercel.app/api

# For local development with Vercel dev server
# VITE_API_URL=http://localhost:3000/api

# App Configuration
VITE_APP_NAME=NextStep Planner
VITE_APP_VERSION=1.0.0